#!/usr/bin/env python3
"""theme-apply: apply a theme (palette + wallpaper) across the desktop.

  theme-apply <theme>                 switch theme (keeps that theme's remembered wallpaper)
  theme-apply --background <file>     set the wallpaper for the current theme
  theme-apply --list                  print themes and wallpapers as JSON (for the switcher)
  theme-apply --current               print the current theme name

Palettes come from ~/.config/quickshell/themes/<name>/colors.toml (Omarchy's format).
Outputs:
  ~/.local/state/quickshell/state.json            read live by Quickshell (palette + wallpaper)
  ~/.local/state/quickshell/theme/hyprland.lua    window border colors, loaded by hyprland.lua
  ~/.local/state/quickshell/theme/hyprlock.conf   lock screen colors, sourced by hyprlock.conf
  ~/.config/kitty/current-theme.conf              kitty colors (kitty reloads on SIGUSR1)
  ~/.config/foot/current-theme.ini                foot colors (new foot windows pick them up)
  org.gnome.desktop.interface color-scheme        prefer-dark / prefer-light, so apps that follow
                                                  "system" (via the appearance portal) match the theme
  org.gnome.desktop.interface gtk-theme           Adwaita-dark / Adwaita, for GTK3 apps
"""
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config" / "quickshell"
THEMES = CONFIG / "themes"
USER_BACKGROUNDS = CONFIG / "backgrounds"          # backgrounds/<theme>/*  (per theme)
SHARED_BACKGROUNDS = HOME / "Pictures" / "Wallpapers"  # offered for every theme
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "quickshell"
STATE = STATE_DIR / "state.json"
OUT = STATE_DIR / "theme"
IMAGE_EXT = {".webp", ".png", ".jpg", ".jpeg"}
DEFAULT_THEME = "retro-82"


def die(msg):
    print(f"theme-apply: {msg}", file=sys.stderr)
    sys.exit(1)


def atomic_write(path: Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def pretty(name):
    return " ".join(w.capitalize() if not w.isdigit() else w for w in name.split("-"))


def hex_rgb(h):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def load_palette(theme):
    f = THEMES / theme / "colors.toml"
    if not f.is_file():
        die(f"no such theme: {theme}")
    with open(f, "rb") as fh:
        raw = tomllib.load(fh)
    pal = {k: v for k, v in raw.items() if isinstance(v, str)}
    # Legacy short names -> canonical, as Omarchy does.
    legacy = {"bg": "background", "fg": "foreground", "dark_bg": "dark_background",
              "darker_bg": "darker_background", "lighter_bg": "lighter_background",
              "dark_fg": "dark_foreground", "light_fg": "light_foreground",
              "bright_fg": "bright_foreground"}
    for old, new in legacy.items():
        if old in pal and new not in pal:
            pal[new] = pal[old]
    pal.setdefault("mode", "dark")
    bg, fg = pal.get("background", "#000000"), pal.get("foreground", "#ffffff")
    pal.setdefault("accent", pal.get("blue", fg))
    pal.setdefault("muted", pal.get("dark_foreground", fg))
    pal.setdefault("dark_background", bg)
    pal.setdefault("darker_background", pal["dark_background"])
    pal.setdefault("lighter_background", bg)
    pal.setdefault("bright_foreground", fg)
    pal.setdefault("selection", pal["lighter_background"])
    return pal


def backgrounds_for(theme):
    found = []
    for d in (THEMES / theme / "backgrounds", USER_BACKGROUNDS / theme, SHARED_BACKGROUNDS):
        if d.is_dir():
            found += sorted(p for p in d.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_EXT)
    return [str(p) for p in found]


def read_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def gradient(value, fallback):
    """'rgba(33ccffee) rgba(00ff99ee) 45deg' -> Lua table; a lone color -> Lua string."""
    value = value or fallback
    parts = value.split()
    angle = next((p for p in parts if p.endswith("deg")), None)
    colors = [p for p in parts if p != angle]
    if len(colors) > 1:
        cols = ", ".join(f'"{c}"' for c in colors)
        return "{ colors = { %s }, angle = %d }" % (cols, int(angle[:-3]) if angle else 0)
    return f'"{colors[0]}"'


def write_hyprland(pal):
    accent_rgb = "rgb(%s)" % pal["accent"].lstrip("#")
    active = gradient(pal.get("hyprland_active_border"), accent_rgb)
    inactive = gradient(pal.get("hyprland_inactive_border"), "rgba(595959aa)")
    atomic_write(OUT / "hyprland.lua", f"""-- Generated by theme-apply. Do not edit.
local active_border_color = {active}
local inactive_border_color = {inactive}

hl.config({{
  general = {{
    col = {{
      active_border = active_border_color,
      inactive_border = inactive_border_color,
    }},
  }},

  group = {{
    col = {{
      border_active = active_border_color,
      border_inactive = inactive_border_color,
    }},
  }},
}})
""")


def write_hyprlock(pal):
    def rgba(h, a="ff"):
        return "rgba(%s%s)" % (h.lstrip("#"), a)
    atomic_write(OUT / "hyprlock.conf", f"""# Generated by theme-apply. Do not edit.
$lock_bg = {rgba(pal['background'])}
$lock_card = {rgba(pal['dark_background'], 'dd')}
$lock_fg = {rgba(pal['foreground'])}
$lock_accent = {rgba(pal['accent'], 'ee')}
$lock_check = {rgba(pal.get('green', pal['accent']), 'ee')}
$lock_fail = {rgba(pal.get('red', '#ff5555'), 'ee')}
""")


def write_kitty(pal):
    sel_fg = pal.get("selection_foreground", pal["bright_foreground"])
    sel_bg = pal.get("selection_background", pal["selection"])
    g = lambda k, d=None: pal.get(k, d or pal["foreground"])
    atomic_write(HOME / ".config" / "kitty" / "current-theme.conf", f"""# Generated by theme-apply. Do not edit.
foreground {pal['foreground']}
background {pal['background']}
selection_foreground {sel_fg}
selection_background {sel_bg}

cursor {pal['bright_foreground']}
cursor_text_color {pal['background']}

dynamic_background_opacity yes

active_border_color {pal['accent']}
active_tab_background {pal['accent']}

color0 {pal['background']}
color1 {g('red')}
color2 {g('green')}
color3 {g('yellow')}
color4 {g('blue')}
color5 {g('magenta')}
color6 {g('cyan')}
color7 {pal['foreground']}
color8 {pal['muted']}
color9 {g('bright_red', g('red'))}
color10 {g('bright_green', g('green'))}
color11 {g('bright_yellow', g('yellow'))}
color12 {g('bright_blue', g('blue'))}
color13 {g('bright_magenta', g('magenta'))}
color14 {g('bright_cyan', g('cyan'))}
color15 {pal['bright_foreground']}
""")
    conf = HOME / ".config" / "kitty" / "kitty.conf"
    include = "include current-theme.conf"
    if not conf.exists():
        atomic_write(conf, f"# kitty config. Colors come from theme-apply.\n{include}\n")
    elif include not in conf.read_text():
        with open(conf, "a") as f:
            f.write(f"\n{include}\n")
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)


def write_foot(pal):
    strip = lambda h: h.lstrip("#")
    g = lambda k, d=None: strip(pal.get(k, d or pal["foreground"]))
    sel_fg = strip(pal.get("selection_foreground", pal["bright_foreground"]))
    sel_bg = strip(pal.get("selection_background", pal["selection"]))
    theme = HOME / ".config" / "foot" / "current-theme.ini"
    atomic_write(theme, f"""# Generated by theme-apply. Do not edit.
[colors]
foreground={strip(pal['foreground'])}
background={strip(pal['background'])}
selection-foreground={sel_fg}
selection-background={sel_bg}

regular0={strip(pal['background'])}
regular1={g('red')}
regular2={g('green')}
regular3={g('yellow')}
regular4={g('blue')}
regular5={g('magenta')}
regular6={g('cyan')}
regular7={strip(pal['foreground'])}

bright0={strip(pal['muted'])}
bright1={g('bright_red', g('red'))}
bright2={g('bright_green', g('green'))}
bright3={g('bright_yellow', g('yellow'))}
bright4={g('bright_blue', g('blue'))}
bright5={g('bright_magenta', g('magenta'))}
bright6={g('bright_cyan', g('cyan'))}
bright7={strip(pal['bright_foreground'])}

[cursor]
color={strip(pal['background'])} {strip(pal['bright_foreground'])}
""")
    # foot's include needs an absolute path, and it must come before the first section.
    conf = HOME / ".config" / "foot" / "foot.ini"
    include = f"include={theme}"
    if not conf.exists():
        atomic_write(conf, f"# foot config. Colors come from theme-apply.\n{include}\n")
    elif "include=" not in conf.read_text():
        atomic_write(conf, f"{include}\n" + conf.read_text())


def write_color_scheme(pal):
    """Tell apps dark or light.

    - color-scheme: served by xdg-desktop-portal as org.freedesktop.appearance, which
      browsers, GTK4/libadwaita, Electron and Qt follow. Hyprland has no flag of its own.
    - gtk-theme: GTK3 apps ignore the portal, so give them Adwaita or Adwaita-dark.
    """
    light = pal["mode"] == "light"
    settings = {
        "color-scheme": "prefer-light" if light else "prefer-dark",
        "gtk-theme": "Adwaita" if light else "Adwaita-dark",
    }
    for key, value in settings.items():
        try:
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return   # no gsettings / dconf: colors still apply everywhere else


def apply(theme, background=None, reload=True):
    pal = load_palette(theme)
    state = read_state()
    remembered = state.get("backgrounds", {})
    if background is None:
        background = remembered.get(theme)
        options = backgrounds_for(theme)
        if not background or background not in options:
            background = options[0] if options else ""
    remembered[theme] = background
    write_hyprland(pal)
    write_hyprlock(pal)
    write_kitty(pal)
    write_foot(pal)
    write_color_scheme(pal)
    atomic_write(STATE, json.dumps({
        "theme": theme, "mode": pal["mode"], "palette": pal,
        "background": background, "backgrounds": remembered,
    }, indent=1))
    if reload:
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, check=False)


def listing():
    state = read_state()
    themes = []
    for d in sorted(p for p in THEMES.iterdir() if (p / "colors.toml").is_file()):
        try:
            pal = load_palette(d.name)
        except SystemExit:
            continue
        prev = d / "preview.png"
        themes.append({
            "name": d.name, "title": pretty(d.name), "mode": pal["mode"],
            "accent": pal["accent"], "background": pal["background"],
            "preview": str(prev) if prev.is_file() else "",
            "backgrounds": backgrounds_for(d.name),
        })
    return {"current": state.get("theme", ""), "background": state.get("background", ""), "themes": themes}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        print(json.dumps(listing()))
        return 0
    if argv[0] == "--current":
        print(read_state().get("theme", ""))
        return 0
    if argv[0] == "--background":
        if len(argv) < 2:
            die("--background needs a file")
        theme = read_state().get("theme") or DEFAULT_THEME
        path = str(Path(argv[1]).expanduser().resolve())
        if not Path(path).is_file():
            die(f"no such file: {path}")
        apply(theme, background=path, reload=False)   # wallpaper only: no compositor reload
        return 0
    if argv[0] == "--init":
        # First run: apply the default theme only if nothing is set yet.
        if not read_state().get("theme"):
            apply(DEFAULT_THEME)
        return 0
    apply(argv[0])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
